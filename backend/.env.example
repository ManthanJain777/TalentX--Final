# ==========================================
# TALENTX - Backend Environment Configuration
# ==========================================

# --- Server Configuration ---
# The port the Spring Boot server will run on
SERVER_PORT=8080

# --- MongoDB Database ---
# The connection string for MongoDB Atlas (or local)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/talentx

# --- Security Secrets ---
# MUST be at least 32 characters long
# Used for signing JWT tokens for authentication
JWT_SECRET=your-256-bit-secret-key-at-least-32-chars-long

# MUST be exactly 32 characters long
# Used for AES-256 encryption of sensitive data (like chat messages or private passport details)
AES_SECRET=your-32-char-aes-secret-key-123456

# --- Email Configuration (JavaMailSender) ---
# Your SMTP username (usually your email address)
MAIL_USERNAME=your-email@gmail.com
# Your SMTP password or App Password (if using Gmail/2FA)
MAIL_PASSWORD=your-app-password
