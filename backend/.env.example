# TALENTX backend environment template
SERVER_PORT=8080

# MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb://localhost:27017/talentx

# Security secrets: never commit real values.
# JWT_SECRET should be a long random value (at least 32 bytes).
JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# AES-256 key: exactly 32 bytes/characters.
AES_SECRET=replace-with-a-32-character-aes-key

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:8080
COOKIE_SECURE=false
